x10 rpe 6 rest 90 seconds\n          bicep_curl 3x12 rpe 6 rest 60 seconds\n          face_pull 3x15 rest 60 seconds\n        cooldown:\n          walking 5m\n          lat_stretch 1m\n          spinal_twist 1m\n\n  PHASE \"Load Reintroduction\" (1 weeks):\n    WEEK 1:\n      DAY Monday training 70m \"Squat - Approach Baseline\":\n        warmup:\n          cycling 8m\n          leg_swings 1m\n          goblet_squat 2x8\n          squat 2x5\n        main straight_sets:\n          squat 5x5 rpe 7 rest 180 seconds\n          romanian_deadlift 3x6 rpe 7 rest 120 seconds\n          split_squat 3x8 rpe 7 rest 90 seconds\n          leg_curl 3x10 rpe 7 rest 75 seconds\n          plank 3x45 rest 60 seconds\n        cooldown:\n          walking 5m\n          hamstring_stretch 1m\n          hip_flexor_stretch 1m\n      DAY Tuesday training 70m \"Bench - Approach Baseline\":\n        warmup:\n          rowing 8m\n          arm_circles 1m\n          scapular_retraction 2x10\n          bench_press 2x5\n        main straight_sets:\n          bench_press 5x5 rpe 7 rest 180 seconds\n          incline_press 3x6 rpe 7 rest 120 seconds\n          dumbbell_row 3x8 rpe 7 rest 90 seconds\n          overhead_press 3x8 rpe 7 rest 90 seconds\n          tricep_pushdown 3x10 rest 60 seconds\n        cooldown:\n          walking 5m\n          chest_stretch 1m\n          shoulder_stretch 1m\n      DAY Thursday training 70m \"Deadlift - Approach Baseline\":\n        warmup:\n          cycling 8m\n          hip_circles 1m\n          romanian_deadlift 2x6\n          deadlift 2x3\n        main straight_sets:\n          deadlift 4x4 rpe 7 rest 180 seconds\n          front_squat 3x6 rpe 7 rest 120 seconds\n          hip_thrust 3x8 rpe 7 rest 90 seconds\n          pull_up 3x6 rpe 7 rest 90 seconds\n          hanging_leg_raise 3x10 rest 60 seconds\n        cooldown:\n          walking 5m\n          pigeon_pose 2m\n          back_stretch 1m\n      DAY Friday training 60m \"Upper Accessory & Volume\":\n 