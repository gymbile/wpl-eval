  "raw_text": "PLAN \"12-Week Upper-Body Program (Shoulder-Friendly)\"\nTYPE workout\nVISIBILITY public\n\nGOALS\n  GOAL primary strength:\n    name \"Upper-body strength and endurance without overhead loading\"\n\nPHASES\n  PHASE \"Phase 1: Foundation (Weeks 1-4)\" (4 weeks):\n    WEEK 1:\n      DAY Monday training 45m \"Upper Body A\":\n        warmup:\n          rowing 5m\n        main straight_sets:\n          bench_press 3x8..12 rpe 6 rest 90 seconds\n          dumbbell_row 3x10..12 rpe 6 rest 90 seconds\n          chest_fly 2x12..15 rpe 6 rest 60 seconds\n          face_pull 3x12..15 rpe 6 rest 60 seconds\n          bicep_curl 2x10..12 rpe 6 rest 60 seconds\n          tricep_pushdown 2x10..12 rpe 6 rest 60 seconds\n        cooldown:\n          chest_stretch 2m\n      DAY Thursday training 45m \"Upper Body B\":\n        warmup:\n          rowing 5m\n        main straight_sets:\n          incline_press 3x8..12 rpe 6 rest 90 seconds\n          seated_row 3x10..12 rpe 6 rest 90 seconds\n          rear_delt_fly 3x12..15 rpe 6 rest 60 seconds\n          cable_row 2x12..15 rpe 6 rest 60 seconds\n          hammer_curl 2x10..12 rpe 6 rest 60 seconds\n          skull_crusher 2x10..12 rpe 6 rest 60 seconds\n        cooldown:\n          shoulder_stretch 2m\n    WEEK 2:\n      DAY Monday training 45m \"Upper Body A\":\n        warmup:\n          rowing 5m\n        main straight_sets:\n          bench_press 3x8..12 rpe 6..7 rest 90 seconds\n          dumbbell_row 3x10..12 rpe 6..7 rest 90 seconds\n          chest_fly 2x12..15 rpe 6..7 rest 60 seconds\n          face_pull 3x12..15 rpe 6..7 rest 60 seconds\n          bicep_curl 2x10..12 rpe 6..7 rest 60 seconds\n          tricep_pushdown 2x10..12 rpe 6..7 rest 60 seconds\n        cooldown:\n          chest_stretch 2m\n      DAY Thursday training 45m \"Upper Body B\":\n        warmup:\n          rowing 5m\n        main straight_sets:\n          incline_press 3x8..12 rpe 6..7 rest 90 seconds\n          seated_row 3x10..12 rpe 6..7 rest 90 seconds\n          rear_delt_fly 3x12..15 rpe 6..7 rest 60 seconds\n          cable_row 2x12..15 rpe 6..7 rest 60 seconds\n          hammer_curl 2x10..12 rpe 6..7 rest 60 seconds\n          skull_crusher 2x10..12 rpe 6..7 rest 60 seconds\n        cooldown:\n          shoulder_stretch 2m\n    WEEK 3:\n      DAY Monday training 45m \"Upper Body A\":\n        warmup:\n          rowing 5m\n        main straight_sets:\n          bench_press 4x6..8 rpe 7 rest 120 seconds\n          dumbbell_row 4x8..10 rpe 7 rest 90 seconds\n          chest_fly 3x10..12 rpe 7 rest 60 seconds\n          face_pull 3x12..15 rpe 7 rest 60 seconds\n          bicep_curl 3x8..10 rpe 7 rest 60 seconds\n          tricep_pushdown 3x8..10 rpe 7 rest 60 seconds\n        cooldown:\n          chest_stretch 2m\n      DAY Thursday training 45m \"Upper Body B\":\n        warmup:\n          rowing 5m\n        main straight_sets:\n          incline_press 4x6..8 rpe 7 rest 120 seconds\n          seated_row 4x8..10 rpe 7 rest 90 seconds\n          rear_delt_fly 3x12..15 rpe 7 rest 60 seconds\n          cable_row 3x10..12 rpe 7 rest 60 seconds\n          hammer_curl 3x8..10 rpe 7 rest 60 seconds\n          skull_crusher 3x8..10 rpe 7 rest 60 seconds\n        cooldown:\n          shoulder_stretch 2m\n    WEEK 4:\n      DAY Monday training 40m \"Upper Deload A\":\n        warmup:\n          rowing 5m\n        main straight_sets:\n          bench_press 2x8..10 rpe 6 rest 90 seconds\n          dumbbell_row 2x10..12 rpe 6 rest 90 seconds\n          face_pull 2x12..15 rpe 6 rest 60 seconds\n          bicep_curl 2x10..12 rpe 6 rest 60 seconds\n        cooldown:\n          chest_stretch 2m\n      DAY Thursday training 40m \"Upper Deload B\":\n        warmup:\n          rowing 5m\n        main straight_sets:\n          incline_press 2x8..10 rpe 6 rest 90 seconds\n          seated_row 2x10..12 rpe 6 rest 90 seconds\n          rear_delt_fly 2x12..15 rpe 6 rest 60 seconds\n          tricep_pushdown 2x10..12 rpe 6 rest 60 seconds\n        cooldown:\n          shoulder_stretch 2m\n  PHASE \"Phase 2: Build (Weeks 5-8)\" (4 weeks):\n    WEEK 5:\n      DAY Monday training 50m \"Upper Strength A\":\n        warmup:\n          rowing 6m\n        main straight_sets:\n          bench_press 4x5..6 rpe 7 rest 150 seconds\n          bent_over_row 4x6..8 rpe 7 rest 120 seconds\n          chest_fly 3x10..12 rpe 7 rest 60 seconds\n          face_pull 3x12..15 rpe 7 rest 60 seconds\n          bicep_curl 3x10..12 rpe 7 rest 60 seconds\n          tricep_pushdown 3x10..12 rpe 7 rest 60 seconds\n        cooldown:\n          shoulder_stretch 2m\n      DAY Thursday training 50m \"Upper Hypertrophy B\":\n        warmup:\n          rowing 6m\n        main straight_sets:\n          incline_press 4x6..8 rpe 7 rest 120 seconds\n          cable_row 4x10..12 rpe 7 rest 90 seconds\n          rear_delt_fly 4x12..15 rpe 7 rest 60 seconds\n          chest_fly 2x12..15 rpe 7 rest 60 seconds\n          hammer_curl 3x10..12 rpe 7 rest 60 seconds\n          skull_crusher 3x10..12 rpe 7 rest 60 seconds\n        cooldown:\n          chest_stretch 2m\n    WEEK 6:\n      DAY Monday training 50m \"Upper Strength A\":\n        warmup:\n          rowing 6m\n        main straight_sets:\n          bench_press 5x4..5 rpe 8 rest 150 seconds\n          bent_over_row 4x6..8 rpe 8 rest 120 seconds\n          chest_fly 3x10..12 rpe 7 rest 60 seconds\n          face_pull 3x12..15 rpe 7 rest 60 seconds\n          bicep_curl 3x8..10 rpe 7 rest 60 seconds\n          tricep_pushdown 3x8..10 rpe 7 rest 60 seconds\n        cooldown:\n          shoulder_stretch 2m\n      DAY Thursday training 50m \"Upper Hypertrophy B\":\n        warmup:\n          rowing 6m\n        main straight_sets:\n          incline_press 4x6..8 rpe 7..8 rest 120 seconds\n          cable_row 4x10..12 rpe 7..8 rest 90 seconds\n          rear_delt_fly 4x12..15 rpe 7..8 rest 60 seconds\n          chest_fly 2x12..15 rpe 7 rest 60 seconds\n          hammer_curl 