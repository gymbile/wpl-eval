  "raw_text": "PLAN \"3-Week Powerlifting Meet Peak\"\nTYPE workout\nVISIBILITY public\n\nGOALS\n  GOAL primary strength:\n    name \"peak for powerlifting meet\"\n\nPHASES\n  PHASE \"Peaking Block\" (3 weeks):\n    WEEK 1:\n      DAY Monday training 60m \"Heavy Squat & Bench\":\n        warmup:\n          cycling 5m\n        main straight_sets:\n          squat 4x3 rpe 8 rest 240 seconds\n          bench_press 4x3 rpe 8 rest 180 seconds\n          bent_over_row 3x6 rpe 7 rest 120 seconds\n        cooldown:\n          hamstring_stretch 3m\n      DAY Wednesday training 60m \"Heavy Deadlift & Bench\":\n        warmup:\n          rowing 5m\n        main straight_sets:\n          deadlift 3x3 rpe 8 rest 300 seconds\n          bench_press 3x3 rpe 8 rest 180 seconds\n          lat_pulldown 3x8 rpe 7 rest 90 seconds\n        cooldown:\n          quad_stretch 3m\n      DAY Friday training 50m \"Squat & Accessories\":\n        warmup:\n          elliptical 5m\n        main straight_sets:\n          squat 3x3 rpe 8 rest 240 seconds\n          overhead_press 3x6 rpe 7 rest 120 seconds\n          lunge 3x8 rpe 7 rest 90 seconds\n        cooldown:\n          hip_flexor_stretch 3m\n    WEEK 2:\n      DAY Monday training 55m \"Squat & Bench Intensity\":\n        warmup:\n          cycling 5m\n        main straight_sets:\n          squat 3x2 rpe 8.5 rest 300 seconds\n          bench_press 3x2 rpe 8.5 rest 180 seconds\n          bent_over_row 2x6 rpe 7 rest 120 seconds\n        cooldown:\n          hamstring_stretch 3m\n      DAY Wednesday training 55m \"Deadlift & Bench Intensity\":\n        warmup:\n          rowing 5m\n        main straight_sets:\n          deadlift 2x2 rpe 8.5 rest 300 seconds\n          bench_press 2x2 rpe 8.5 rest 180 seconds\n          lat_pulldown 2x8 rpe 7 rest 90 seconds\n        cooldown:\n          quad_stretch 3m\n      DAY Friday training 45m \"Squat & Accessories\":\n        warmup:\n          elliptical 5m\n        main straight_sets:\n          squat 2x2 rpe 8.5 rest 240 seconds\n          overhead_press 2x6 rpe 7 rest 120 seconds\n          lunge 2x8 rpe 7 rest 90 seconds\n        cooldown:\n          hip_flexor_stretch 3m\n    WEEK 3:\n      DAY Monday training 40m \"Openers Practice\":\n        warmup:\n          cycling 5m\n        main straight_sets:\n          squat 1x1 rpe 8 rest 300 seconds\n          bench_press 1x1 rpe 8 rest 240 seconds\n          deadlift 1x1 rpe 8 rest 300 seconds\n        cooldown:\n          hamstring_stretch 3m\n      DAY Wednesday training 30m \"Technique & Mobility\":\n        warmup:\n          rowing 5m\n        main straight_sets:\n          squat 2x1 rpe 7 rest 240 seconds\n          bench_press 2x1 rpe 7 rest 180 seconds\n        cooldown:\n          quad_stretch 3m\n          hip_flexor_stretch 3m\n      DAY Saturday training 20m \"Meet Day Warmup\":\n        warmup:\n          cycling 5m\n        main straight_sets:\n          squat 1x1 rpe 6 rest 180 seconds\n          bench_press 1x1 rpe 6 rest 180 seconds\n          deadlift 1x1 rpe 6 rest 180 seconds\n        cooldown:\n          diaphragmatic_breathing 3m",
