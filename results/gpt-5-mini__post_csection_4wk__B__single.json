  "raw_text": "PLAN \"Postpartum Return - 12 Week Progressive Recovery\"\nTYPE workout\nVISIBILITY public\n\nGOALS\n  GOAL primary strength:\n    name \"Return to baseline strength and function\"\n\nPHASES\n  PHASE \"Phase 1 - Weeks 1-4 (Postpartum weeks 4-7) (Recovery & walking emphasis)\" (4 weeks):\n    WEEK 1:\n      DAY Monday training 20m \"Gentle walk + mobility\":\n        warmup:\n          walking 10m\n        main straight_sets:\n          diaphragmatic_breathing 3x6 rpe 2 rest 30 seconds\n        cooldown:\n          walking 5m\n      DAY Wednesday training 25m \"Mobility and pelvic floor focus\":\n        warmup:\n          walking 10m\n        main straight_sets:\n          pelvic_tilt 3x10 rpe 3 rest 30 seconds\n          bird_dog 3x6..8 rpe 3 rest 45 seconds\n        cooldown:\n          child_pose 5m\n      DAY Friday training 25m \"Easy walk + low load posterior chain\":\n        warmup:\n          walking 10m\n        main straight_sets:\n          glute_bridge 3x8..10 rpe 4 rest 45 seconds\n          hip_abduction 3x8..10 rpe 4 rest 45 seconds\n        cooldown:\n          walking 5m\n    WEEK 2:\n      DAY Monday training 25m \"Progress walk + breathing\":\n        warmup:\n          walking 12m\n        main straight_sets:\n          diaphragmatic_breathing 3x8 rpe 2 rest 30 seconds\n          glute_bridge 3x10 rpe 4 rest 45 seconds\n        cooldown:\n          child_pose 5m\n      DAY Wednesday training 30m \"Mobility and core-protective activation\":\n        warmup:\n          walking 12m\n        main straight_sets:\n          pelvic_tilt 3x12 rpe 3 rest 30 seconds\n          bird_dog 3x8 rpe 3 rest 45 seconds\n          heel_slide  (Note: heel_slide not in vocabulary; substitute)\n        cooldown:\n          cat_cow 5m\n      DAY Friday training 30m \"Walk + light lower body\":\n        warmup:\n          walking 15m\n        main straight_sets:\n          glute_bridge 3x12 rpe 5 rest 45 seconds\n          step_up 3x8 rpe 5 rest 60 seconds\n        cooldown:\n          walking 5m\n    WEEK 3:\n      DAY Monday training 30m \"Walk + pelvic stability\":\n        warmup:\n          walking 15m\n        main straight_sets:\n          pelvic_tilt 3x15 rpe 3 rest 30 seconds\n          bird_dog 3x10 rpe 3 rest 45 seconds\n        cooldown:\n          child_pose 5m\n      DAY Wednesday training 30m \"Mobility and light conditioning\":\n        warmup:\n          walking 15m\n        main straight_sets:\n          glute_bridge 3x12 rpe 5 rest 45 seconds\n          march_in_place  (Note: march_in_place not in vocabulary; substitute)\n        cooldown:\n          cat_cow 5m\n      DAY Friday training 35m \"Longer walk\":\n        warmup:\n          walking 20m\n        main straight_sets:\n          diaphragmatic_breathing 3x8 rpe 2 rest 30 seconds\n        cooldown:\n          walking 5m\n    WEEK 4:\n      DAY Monday training 35m \"Walk + activation\":\n        warmup:\n          walking 20m\n        main straight_sets:\n          glute_bridge 3x15 rpe 5 rest 45 seconds\n          hip_abduction 3x12 rpe 5 rest 45 seconds\n        cooldown:\n          child_pose 5m\n      DAY Wednesday training 35m \"Mobility and gentle strength\":\n        warmup:\n          walking 20m\n        main straight_sets:\n          pelvic_tilt 3x15 rpe 3 rest 30 seconds\n          bird_dog 3x12 rpe 4 rest 45 seconds\n        cooldown:\n          cat_cow 5m\n      DAY Friday training 40m \"End week walk\":\n        warmup:\n          walking 25m\n        main straight_sets:\n          diaphragmatic_breathing 3x8 rpe 2 rest 30 seconds\n        cooldown:\n          walking 5m\n\n  PHASE \"Phase 2 - Weeks 5-8 (Weeks 8-11 postpartum) (Rebuild strength, no loading heavy lifts)\" (4 weeks):\n    WEEK 1:\n      DAY Monday training 30m \"Walk + bodyweight lower\":\n        warmup:\n          walking 15m\n        main straight_sets:\n          glute_bridge 3x15 rpe 5 rest 45 seconds\n          squat 3x8..10 rpe 5 rest 60 seconds\n        cooldown:\n          hamstring_stretch 5m\n      DAY Wednesday training 30m \"Mobility and upper body (no heavy load)\":\n        warmup:\n          walking 10m\n        main straight_sets:\n          shoulder_circles 3x20 rpe 2 rest 20 seconds\n          wall_push_up  (Note: wall_push_up not in vocabulary; substitute) \n        cooldown:\n          chest_stretch 5m\n      DAY Friday training 35m \"Walk + unilateral stability\":\n        warmup:\n          walking 15m\n        main straight_sets:\n          step_up 3x10 rpe 5 rest 45 seconds\n          reverse_lunge 3x8 rpe 5 rest 60 seconds\n        cooldown:\n          calf_stretch 5m\n    WEEK 2:\n      DAY Monday training 35m \"Progressive bodyweight\":\n        warmup:\n          walking 15m\n        main straight_sets:\n          squat 3x10 rpe 6 rest 60 seconds\n          glute_bridge 3x15 rpe 6 rest 45 seconds\n        cooldown:\n          hip_flexor_stretch 5m\n      DAY Wednesday training 35m \"Upper mobility and scapular work\":\n        warmup:\n          walking 10m\n        main straight_sets:\n          scapular_retraction 3x12 rpe 4 rest 30 seconds\n          prone_T 3x10 rpe 4 rest 30 seconds\n        cooldown:\n          shoulder_stretch 5m\n      DAY Friday training 40m \"Longer walk + core-protective drills\":\n        warmup:\n          walking 25m\n        main straight_sets:\n          bird_dog 3x12 rpe 4 rest 45 seconds\n          pelvic_tilt 3x15 rpe 3 rest 30 seconds\n        cooldown:\n          walking 5m\n    WEEK 3:\n      DAY Monday training 35m \"Lower body strength (bodyweight)\":\n        warmup:\n          walking 15m\n        main straight_sets:\n          squat 3x12 rpe 6 rest 60 seconds\n          lateral_lunge 3x8 rpe 6 rest 60 seconds\n        cooldown:\n          quad_stretch 5m\n      DAY Wednesday training 35m \"Upper body fundamentals\":\n        warmup:\n          walking 10m\n        main straight_sets:\n          push_up 3x6..8 rpe 6 rest 60 seconds\n          inverted_row 3x6..8 rpe 6 rest 60 seconds\n        cooldown:\n          chest_stretch 5m\n      DAY Friday training 45m \"Walk and conditioning\":\n        warmup:\n          walking 30m\n        main straight_sets:\n          diaphragmatic_breathing 3x8 rpe 2 rest 30 seconds\n        cooldown:\n          walking 5m\n    WEEK 4:\n      DAY Monday training 40m \"Strength endurance\":\n        warmup:\n          walking 15m\n        main straight_sets:\n          squat 3x12 rpe 7 rest 60 seconds\n          glute_bridge 3x15 rpe 6 rest 45 seconds\n        cooldown:\n          hamstring_stretch 5m\n      DAY Wednesday training 40m \"Upper body control\":\n        warmup:\n          walking 10m\n        main straight_sets:\n          push_up 3x8 rpe 7 rest 60 seconds\n          scapular_retraction 3x15 rpe 5 rest 30 seconds\n        cooldown:\n          shoulder_stretch 5m\n      DAY Friday training 45m \"Long walk + mobility\":\n        warmup:\n          walking 35m\n        main straight_sets:\n          bird_dog 3x12 rpe 4 rest 45 seconds\n        cooldown:\n          child_pose 5m\n\n  PHASE \"Phase 3 - Weeks 9-12 (Weeks 12-15 postpartum) (Gradual return to regular strength work)\" (4 weeks):\n    WEEK 1:\n      DAY Monday training 45m \"Lower body progression\":\n        warmup:\n          walking 10m\n        main straight_sets:\n          squat 4x8..10 rpe 7 rest 90 seconds\n          glute_bridge 4x12 rpe 7 rest 60 seconds\n        cooldown:\n          hamstring_stretch 5m\n      DAY Wednesday training 45m \"Upper body progression\":\n        warmup:\n          walking 10m\n        main straight_sets:\n          push_up 4x8..10 rpe 7 rest 90 seconds\n          inverted_row 4x8..10 rpe 7 rest 90 seconds\n        cooldown:\n          chest_stretch 5m\n      DAY Friday training 50m \"Mixed functional\":\n        warmup:\n          walking 30m\n        main straight_sets:\n          step_up 3x12 rpe 7 rest 60 seconds\n          lateral_lunge 3x10 rpe 7 rest 60 seconds\n        cooldown:\n          child_pose 5m\n    WEEK 2:\n      DAY Monday training 50m \"Strength + stability\":\n        warmup:\n          walking 10m\n        main straight_sets:\n          squat 4x8..10 rpe 7 rest 90 seconds\n          hip_abduction 3x12 rpe 6 rest 60 seconds\n        cooldown:\n          quad_stretch 5m\n      DAY Wednesday training 50m \"Upper pull/push balance\":\n        warmup:\n          walking 10m\n        main straight_sets:\n          push_up 4x10 rpe 7 rest 90 seconds\n          inverted_row 4x10 rpe 7 rest 90 seconds\n        cooldown:\n          shoulder_stretch 5m\n      DAY Friday training 55m \"Long walk + mobility\":\n        warmup:\n          walking 40m\n        main straight_sets:\n          diaphragmatic_breathing 3x10 rpe 2 rest 30 seconds\n        cooldown:\n          walking 5m\n    WEEK 3:\n      DAY Monday training 50m \"Higher volume lower\":\n        warmup:\n          walking 10m\n        main straight_sets:\n          squat 4x10..12 rpe 7 rest 90 seconds\n          glute_bridge 4x15 rpe 7 rest 60 seconds\n        cooldown:\n          hamstring_stretch 5m\n      DAY Wednesday training 50m \"Upper strength endurance\":\n        warmup:\n          walking 10m\n        main straight_sets:\n          push_up 4x10..12 rpe 7 rest 90 seconds\n          inverted_row 4x10..12 rpe 7 rest 90 seconds\n        cooldown:\n          chest_stretch 5m\n      DAY Friday training 60m \"Functional endurance\":\n        warmup:\n          walking 45m\n        main straight_sets:\n          step_up 4x12 rpe 7 rest 60 seconds\n        cooldown:\n          child_pose 5m\n    WEEK 4:\n      DAY Monday training 60m \"Consolidation session\":\n        warmup:\n          walking 10m\n        main straight_sets:\n          squat 4x10..12 rpe 7 rest 90 seconds\n          glute_bridge 4x15 rpe 7 rest 60 seconds\n          hip_abduction 3x15 rpe 6 rest 45 seconds\n        cooldown:\n          hamstring_stretch 5m\n      DAY Wednesday training 60m \"Upper consolidation\":\n        warmup:\n          walking 10m\n        main straight_sets:\n          push_up 4x10..12 rpe 7 rest 90 seconds\n          inverted_row 4x10..12 rpe 7 rest 90 seconds\n          scapular_retraction 3x15 rpe 6 rest 30 seconds\n        cooldown:\n          shoulder_stretch 5m\n      DAY Friday training 60m \"Transition walk and mobility\":\n        warmup:\n          walking 45m\n        main straight_sets:\n          diaphragmatic_breathing 3x10 rpe 2 rest 30 seconds\n        cooldown:\n          child_pose 5m",
